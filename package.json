{
  "name": "wt-api-client",
  "version": "0.1.0",
  "description": "Library for convenient calling of the standard WebSoft API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "keywords": [
    "api",
    "bs",
    "borisscript",
    "ssjs",
    "server side javascript",
    "wt",
    "webtutor",
    "websoft"
  ],
  "author": "wracce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wracce/wt-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/wracce/wt-api-client/issues"
  },
  "homepage": "https://github.com/wracce/wt-api-client#readme",
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.2.0",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
